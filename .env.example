# PMSI Environment Configuration Example
# Copy this file to .env and provide verified credentials to activate live automated inquiry delivery.

# Server Port (Optional, default: 3000)
PORT=3000

# OPTION 1: SMTP Configuration
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-domain.org
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=false

# OPTION 2: API Key Configuration (e.g. Resend / SendGrid)
# EMAIL_SERVICE_API_KEY=re_1234567890abcdef
# RESEND_API_KEY=re_1234567890abcdef

# RECIPIENT EMAIL (Official verified organizational inbox)
# INQUIRY_RECIPIENT_EMAIL=partnerships@pmsi.org
